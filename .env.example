# ============================================================================
# EdiFeasy - Variables de entorno
# Copia este archivo como `.env` y reemplaza los valores por los de tu proyecto.
# NUNCA subas el archivo `.env` al repositorio.
# ============================================================================

# --- Frontend (expuestas al navegador, solo claves publicas) -----------------
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.PUBLIC_ANON_KEY
VITE_SENTRY_DSN=
VITE_APP_NAME=EdiFeasy
VITE_APP_ENV=development

# --- Solo para scripts de servidor (scripts/seed-users.ts) -------------------
