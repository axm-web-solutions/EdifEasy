{
  "name": "edifeasy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "EdiFeasy - SaaS multi-tenant para la administracion de condominios, edificios y conjuntos residenciales",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx scripts/seed-users.ts",
    "check": "tsx scripts/check-supabase.ts",
    "deadcode": "npx -y knip@5 --config .knip.json",
    "screenshots": "node scripts/screenshots.mjs",
    "guide": "node scripts/build-guide.mjs",
    "responsive": "node scripts/responsive-check.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "3.9.0",
    "@supabase/supabase-js": "2.45.4",
    "@tanstack/react-query": "5.59.16",
    "antd": "5.21.6",
    "dayjs": "1.11.13",
    "lucide-react": "0.454.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.53.1",
    "react-router-dom": "6.27.0",
    "recharts": "2.13.0",
    "workbox-window": "^7.4.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "9.13.0",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.2",
    "@testing-library/react": "16.0.1",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "22.8.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "5.0.4",
    "autoprefixer": "10.4.20",
    "dotenv": "16.4.5",
    "eslint": "9.13.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "eslint-plugin-react-refresh": "0.4.14",
    "globals": "15.11.0",
    "jsdom": "25.0.1",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.14",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "typescript-eslint": "8.11.0",
    "vite": "6.4.3",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
