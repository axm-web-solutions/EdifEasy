    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx scripts/seed-users.ts",
    "check": "tsx scripts/check-supabase.ts",
    "deadcode": "npx -y knip@5 --config .knip.json",
    "screenshots": "node scripts/screenshots.mjs",
    "guide": "node scripts/build-guide.mjs",
    "responsive": "node scripts/responsive-check.mjs",
    "verify:plan": "node scripts/verify-plan.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "3.10.0",
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-query": "5.104.4",
    "antd": "5.29.3",
    "dayjs": "1.11.23",
    "driver.js": "^1.10.1",
    "leaflet": "1.9.4",
    "lucide-react": "0.454.0",
    "pdfjs-dist": "5.7.284",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.90.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "6.30.6",
